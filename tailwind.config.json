{
    "darkMode": "class",
    "theme": {
        "extend": {
            "colors": {
                "palette": {
                    "canvas": "#F9F7F7",
                    "soft": "#DBE2EF",
                    "primary": "#3F72AF",
                    "navy": "#112D4E"
                }
            },
            "fontFamily": {
                "sans": ["Plus Jakarta Sans", "system-ui", "sans-serif"],
                "mono": ["JetBrains Mono", "monospace"]
            },
            "animation": {
                "marquee": "marquee 28s linear infinite",
                "blink": "blink 1.1s step-start infinite"
            },
            "keyframes": {
                "marquee": {
                    "0%": { "transform": "translateX(0%)" },
                    "100%": { "transform": "translateX(-50%)" }
                },
                "blink": {
                    "0%, 100%": { "opacity": "1" },
                    "50%": { "opacity": "0" }
                }
            }
        }
    }
}
